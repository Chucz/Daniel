# Server functions only. Configure in Netlify; never expose in browser code.
# Copy the Transaction pooler URI from the Supabase Connect panel.
# Use the eduscale_app database role with its own password (URL-encoded).
SUPABASE_DATABASE_URL=postgresql://eduscale_app.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
AUTH_USER=
AUTH_PASSWORD=
